# dependencies
/node_modules
/.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files — never commit secrets
.env
.env.local
.env*.local

# vercel
.vercel

# Claude Code working dir — local settings, caches and session state stay out.
# `.claude/skills/` is the exception: skills committed here load in every
# session, including the cloud ones where plugins can't be installed.
# Note the `/*` rather than `/` — git won't descend into an ignored directory,
# so the negation below only works if the directory itself isn't ignored.
.claude/*
!.claude/skills/

# typescript
*.tsbuildinfo

# test / build output
/coverage
/scratch

.vercel
.env*
