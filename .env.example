# ── Crewcraft Estimate Builder — environment ───────────────────────────────
# Copy this file to .env.local and fill in real values. See SETUP.md for where
# each value comes from. Never commit .env.local — secrets stay server-side.

# Anthropic — line-item generator (SERVER ONLY, never expose to the browser)
ANTHROPIC_API_KEY=

# Supabase — project URL + keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. SERVER ONLY — used for the public estimate
# page, Stripe webhook sync, and email/PDF generation.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — checkout, customer portal, webhooks (all SERVER ONLY)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect webhook (separate endpoint that listens to events on
# CONNECTED accounts — powers auto-mark-paid). See SETUP.md.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_FOUNDING=

# Resend — sending the estimate email (SERVER ONLY)
RESEND_API_KEY=
# Verified "from" address on your Resend domain, e.g. estimates@yourdomain.com
RESEND_FROM_EMAIL=

# Public base URL of the app (used for magic-link redirects, public estimate
# links, and Stripe return URLs). No trailing slash. e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Follow-up reminder cron (SERVER ONLY, optional). Any long random string —
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` when calling
# /api/cron/reminders (see vercel.json). Leave empty to disable auto follow-ups.
CRON_SECRET=
