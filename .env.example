# ── Crewcraft Estimate Builder — environment ───────────────────────────────
# Copy this file to .env.local and fill in real values. See SETUP.md for where
# each value comes from. Never commit .env.local — secrets stay server-side.

# Anthropic — line-item generator (SERVER ONLY, never expose to the browser)
ANTHROPIC_API_KEY=

# Supabase — project URL + keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key bypasses RLS. SERVER ONLY — used for the public estimate
# page, Stripe webhook sync, and email/PDF generation.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe — checkout, customer portal, webhooks (all SERVER ONLY)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Connect webhook (separate endpoint that listens to events on
# CONNECTED accounts — powers auto-mark-paid). See SETUP.md.
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_FOUNDING=

# Resend — sending the estimate email (SERVER ONLY)
RESEND_API_KEY=
# Verified "from" address on your Resend domain, e.g. estimates@yourdomain.com
RESEND_FROM_EMAIL=

# Public base URL of the app (used for magic-link redirects, public estimate
# links, and Stripe return URLs). No trailing slash. e.g. http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Follow-up reminder cron (SERVER ONLY, optional). Any long random string —
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET` when calling
# /api/cron/reminders (see vercel.json). Leave empty to disable auto follow-ups.
CRON_SECRET=

# Owner/admin accounts (SERVER ONLY, optional). Comma-separated emails that
# get unlimited estimates without a subscription — e.g. the founder's account.
OWNER_EMAILS=

# Google Ads signup conversion (optional). Create a "Sign-up" conversion action
# in Google Ads → Goals → Conversions, then paste its send_to id here, e.g.
# AW-18291771001/AbC-dEfGhIjKlMnOp. Fired once on /onboarding after signup.
NEXT_PUBLIC_GOOGLE_ADS_SIGNUP_LABEL=

# Google tag ids (optional overrides). The live Ads id (AW-…) and GA4
# measurement id (G-…) are the defaults in src/components/GoogleTag.tsx — both
# are public identifiers — so these only need values to point a fork or staging
# deploy at a different Ads account / GA4 property. GA4 → Admin → Data streams
# → your stream → Measurement ID.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GA4_ID=

# Umami analytics (optional override). The live website id is the default in
# src/app/layout.tsx; set this only to point a fork or staging deploy at a
# different Umami site. Find it in Umami → Settings → Websites.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Meta (Facebook) Pixel (optional override). The live pixel id is the default
# in src/components/MetaPixel.tsx, so this only needs a value to point a fork
# or a staging deploy at a different pixel. Meta Events Manager → your Pixel →
# Settings → numeric Pixel ID. Fires PageView on every page and
# CompleteRegistration once on /onboarding.
NEXT_PUBLIC_META_PIXEL_ID=
